# Shared runtime settings
REDIS_PORT=6379
REDIS_PASSWORD=change-me

KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
# External host/IP for clients outside Docker (set to EC2 public IP or domain)
KAFKA_EXTERNAL_HOST=localhost:9094

# External database endpoints (RDS or other managed DB)
CINEMA_DB_URL=jdbc:mysql://your-rds-endpoint:3306/cinema_db
CINEMA_DB_USERNAME=cinema_user
CINEMA_DB_PASSWORD=cinema_pass

ORDER_DB_URL=jdbc:mysql://your-rds-endpoint:3306/order_db
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=order_pass

PAYMENT_DB_URL=jdbc:mysql://your-rds-endpoint:3306/payment_db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=payment_pass

PRODUCT_DB_URL=jdbc:mysql://your-rds-endpoint:3306/product_db
PRODUCT_DB_USERNAME=product_user
PRODUCT_DB_PASSWORD=product_pass

TICKET_DB_URL=jdbc:mysql://your-rds-endpoint:3306/ticket_db
TICKET_DB_USERNAME=ticket_user
TICKET_DB_PASSWORD=ticket_pass

USER_DB_URL=jdbc:mysql://your-rds-endpoint:3306/user_db
USER_DB_USERNAME=user_user
USER_DB_PASSWORD=user_pass

AI_DB_URL=jdbc:postgresql://your-rds-endpoint:5432/ai_db
AI_DB_USERNAME=ai_user
AI_DB_PASSWORD=ai_pass
